
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111827">
<meta name="description" content="Novareach Digital - Discover people, watch videos, buy and sell products and services, and grow your community.">
<title>Novareach Digital | Social Marketplace</title>
<style>
:root {
  --bg:#f4f6fb;
  --card:#ffffff;
  --text:#182033;
  --muted:#68738a;
  --primary:#635bff;
  --border:#e6e9f1;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font-family:Arial,Helvetica,sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.topbar{background:#111827;color:white;padding:14px 5%;
display:flex;align-items:center;justify-content:space-between;gap:12px;
position:sticky;top:0;z-index:10}
.brand{font-size:21px;font-weight:800;color:white}
.brand span{color:#a5a0ff}
.search{max-width:400px;width:40%;padding:11px 14px;
border:0;border-radius:25px;background:#263145;color:white}
.layout{max-width:1250px;margin:auto;display:grid;
grid-template-columns:200px minmax(0,1fr) 240px;gap:20px;padding:22px 15px}
.panel,.card{background:var(--card);border:1px solid var(--border);
border-radius:17px;padding:17px;margin-bottom:16px}
.sidebar{position:sticky;top:82px;align-self:start}
.navbtn{width:100%;border:0;background:transparent;text-align:left;
padding:12px;border-radius:10px;margin:3px 0;color:var(--text)}
.navbtn:hover,.navbtn.active{background:#eeedff;color:var(--primary)}
h1,h2,h3,p{margin-top:0}
h1{font-size:27px}
h2{font-size:19px}
.muted{color:var(--muted);font-size:13px;line-height:1.5}
.btn{border:0;border-radius:10px;padding:10px 14px;
background:var(--primary);color:white;font-weight:700}
.btn.light{background:#efefff;color:var(--primary)}
.btn.dark{background:#111827;color:white}
.btn.small{padding:7px 10px;font-size:12px}
.full{width:100%}
.hero{background:linear-gradient(130deg,#191c46,#635bff,#b35cff);
color:white;padding:27px;border-radius:20px;margin-bottom:17px}
.hero h1{font-size:30px;margin-bottom:10px}
.hero p{max-width:500px;line-height:1.6}
.hero .btn{background:white;color:#4038c9}
.sectionhead{display:flex;align-items:center;
justify-content:space-between;gap:10px;margin:20px 0 12px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.product{overflow:hidden;padding:0}
.productart{height:145px;display:flex;align-items:center;
justify-content:center;font-size:55px;background:#eeedff}
.productinfo{padding:14px}
.price{font-weight:800;font-size:18px;color:var(--primary)}
.row{display:flex;align-items:center;gap:10px}
.between{justify-content:space-between}
.avatar{width:43px;height:43px;flex-shrink:0;border-radius:50%;
display:flex;align-items:center;justify-content:center;
background:#e6e3ff;color:#5047d8;font-weight:800}
.posthead{display:flex;align-items:center;gap:10px;margin-bottom:13px}
.postbody{line-height:1.65;overflow-wrap:anywhere}
.postactions{display:flex;gap:9px;flex-wrap:wrap;margin-top:13px}
.postactions button{border:0;background:#f1f3fa;padding:9px 12px;
border-radius:9px;color:#343d53}
.videoart{height:185px;border-radius:13px;
background:linear-gradient(145deg,#17192f,#6256e8,#f0a7ff);
display:flex;align-items:center;justify-content:center;
font-size:48px;color:white;margin-bottom:13px}
input,textarea,select{width:100%;padding:12px;
border:1px solid var(--border);border-radius:10px;
margin:5px 0 12px;background:white;color:var(--text)}
textarea{min-height:90px;resize:vertical}
label{font-size:13px;font-weight:700}
.notice{background:#fff8df;color:#6f5513;border-radius:10px;
padding:12px;font-size:12px;line-height:1.6;margin-bottom:15px}
.person{display:flex;align-items:center;gap:10px;margin:14px 0}
.personinfo{flex:1;min-width:0}
.personinfo strong{display:block;font-size:13px}
.personinfo span{font-size:11px;color:var(--muted)}
.tag{display:inline-block;padding:5px 9px;background:#eeedff;
color:#5148d4;border-radius:20px;font-size:11px;margin:3px}
.empty{text-align:center;padding:30px;color:var(--muted)}
.page{display:none}
.page.active{display:block}
.bottomnav{display:none}
footer{text-align:center;color:var(--muted);font-size:12px;padding:25px}
a{color:var(--primary)}
@media(max-width:950px){
.layout{grid-template-columns:175px minmax(0,1fr)}
.rightbar{display:none}
}
@media(max-width:650px){
.topbar{padding:12px;flex-wrap:wrap}
.brand{font-size:19px}
.search{order:3;width:100%;max-width:none}
.layout{display:block;padding:12px 10px 85px}
.sidebar{display:none}
.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.productart{height:105px;font-size:42px}
.productinfo{padding:10px}
.hero{padding:20px}
.hero h1{font-size:25px}
.card,.panel{padding:14px;border-radius:14px}
.bottomnav{display:flex;position:fixed;bottom:0;left:0;right:0;
background:white;border-top:1px solid var(--border);
justify-content:space-around;padding:7px 2px;
z-index:20}
.bottomnav button{background:none;border:0;font-size:10px;
color:var(--muted);padding:7px 3px}
.bottomnav button.active{color:var(--primary);font-weight:800}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">Nova<span>reach</span></div>
  <input class="search" id="search" placeholder="Search people, products, services...">
  <button class="btn" onclick="openPage('profile')">My Profile</button>
</header>

<div class="layout">
  <aside class="sidebar panel">
    <h3>Explore</h3>
    <button class="navbtn active" data-page="home" onclick="openPage('home')">🏠 Home</button>
    <button class="navbtn" data-page="market" onclick="openPage('market')">🛍️ DND Marketplace</button>
    <button class="navbtn" data-page="friends" onclick="openPage('friends')">👥 Find Friends</button>
    <button class="navbtn" data-page="videos" onclick="openPage('videos')">▶️ Short Videos</button>
    <button class="navbtn" data-page="growth" onclick="openPage('growth')">🚀 Growth Services</button>
    <button class="navbtn" data-page="create" onclick="openPage('create')">➕ Create Post</button>
    <button class="navbtn" data-page="profile" onclick="openPage('profile')">👤 My Profile</button>
    <hr style="border:0;border-top:1px solid var(--border)">
    <p class="muted">Discover people. Share ideas. Build your business.</p>
  </aside>

  <main>
    <section id="home" class="page active">
      <div class="hero">
        <span class="tag">SOCIAL + COMMERCE</span>
        <h1>Your world. Your people. Your business.</h1>
        <p>Meet new friends, share content, discover videos, and find products and services in one place.</p>
        <button class="btn" onclick="openPage('market')">Explore Marketplace →</button>
        <button class="btn" onclick="openPage('create')">Create a Post</button>
      </div>

      <div class="card" style="border:2px solid #dedaff">
        <div class="row between">
          <div class="row">
            <div class="avatar">N</div>
            <div>
              <strong id="featuredName">Your Creator Account</strong>
              <div class="muted">Featured creator · Novareach Digital</div>
            </div>
          </div>
          <button class="btn" id="featuredFollow" onclick="followFeatured()">+ Follow</button>
        </div>
        <p class="muted" style="margin:12px 0 0">
          Follow our featured creator for updates, new content, and community news.
        </p>
      </div>

      <div class="sectionhead">
        <h2>Discover the marketplace</h2>
        <button class="btn light small" onclick="openPage('market')">See all</button>
      </div>
      <div class="grid" id="homeProducts"></div>

      <div class="sectionhead"><h2>Community feed</h2></div>
      <div id="homePosts"></div>
    </section>

    <section id="market" class="page">
      <div class="sectionhead"><h1>DND Marketplace</h1></div>
      <p class="muted">Discover independent sellers, products, and services.</p>
      <div class="card">
        <label>Find an item</label>
        <input id="productSearch" placeholder="Search the marketplace..." oninput="renderProducts()">
        <label>Category</label>
        <select id="productCategory" onchange="renderProducts()">
          <option value="All">All categories</option>
          <option>Electronics</option><option>Fashion</option>
          <option>Services</option><option>Digital</option>
        </select>
      </div>
      <div class="grid" id="allProducts"></div>
      <div class="card">
        <h2>Sell on Novareach</h2>
        <p class="muted">Add a product or service listing to this demo.</p>
        <form id="productForm">
          <label>Product or service name</label>
          <input id="pName" required maxlength="100" placeholder="e.g. Graphic design">
          <label>Price (NGN)</label>
          <input id="pPrice" type="number" min="0" required placeholder="5000">
          <label>Category</label>
          <select id="pCategory"><option>Services</option><option>Electronics</option><option>Fashion</option><option>Digital</option></select>
          <label>Description</label>
          <textarea id="pDesc" required maxlength="500" placeholder="Describe what you offer"></textarea>
          <button class="btn full">Add Listing</button>
        </form>
      </div>
    </section>

    <section id="friends" class="page">
      <h1>Find Friends</h1>
      <p class="muted">Discover community members and follow their updates.</p>
      <div class="card">
        <h2>Featured account</h2>
        <div id="featuredPerson"></div>
      </div>
      <div class="card">
        <h2>Community members</h2>
        <div id="peopleList"></div>
      </div>
    </section>

    <section id="videos" class="page">
      <h1>Short Videos</h1>
      <p class="muted">A starting point for a short-form video community.</p>
      <div class="notice">These are demo video cards. Real video uploads, playback, and live streaming require video hosting and backend integration.</div>
      <div id="videoFeed"></div>
      <div class="card">
        <h2>Share a video link</h2>
        <form id="videoForm">
          <label>Video title</label>
          <input id="vTitle" required maxlength="100" placeholder="My new video">
          <label>Public video URL</label>
          <input id="vUrl" type="url" required placeholder="https://...">
          <button class="btn full">Add Video Link</button>
        </form>
      </div>
    </section>

    <section id="growth" class="page">
      <h1>Growth Services</h1>
      <p class="muted">Find services that help creators and businesses grow.</p>
      <div class="grid">
        <div class="card">
          <div style="font-size:35px">🎬</div>
          <h3>Video Editing</h3>
          <p class="muted">Improve your videos for social platforms.</p>
          <span class="tag">Creator service</span>
        </div>
        <div class="card">
          <div style="font-size:35px">📣</div>
          <h3>Social Media Marketing</h3>
          <p class="muted">Plan campaigns and reach genuine audiences.</p>
          <span class="tag">Marketing</span>
        </div>
        <div class="card">
          <div style="font-size:35px">🎨</div>
          <h3>Design & Branding</h3>
          <p class="muted">Create logos, thumbnails, and branded content.</p>
          <span class="tag">Creative</span>
        </div>
        <div class="card">
          <div style="font-size:35px">📈</div>
          <h3>Creator Consulting</h3>
          <p class="muted">Get help with content strategy and audience growth.</p>
          <span class="tag">Consulting</span>
        </div>
      </div>
      <div class="notice">This section is a showcase, not a live service marketplace. Avoid fake followers, bots, or deceptive engagement. Paid services and transactions must be connected to verified sellers and secure payments before launch.</div>
    </section>

    <section id="create" class="page">
      <h1>Create a Post</h1>
      <div class="card">
        <form id="postForm">
          <label>Your display name</label>
          <input id="postName" required maxlength="50" placeholder="Your name">
          <label>What's happening?</label>
          <textarea id="postText" required maxlength="2000" placeholder="Share something with the community..."></textarea>
          <button class="btn full">Publish Post</button>
        </form>
      </div>
    </section>

    <section id="profile" class="page">
      <h1>My Profile</h1>
      <div class="card">
        <div class="avatar" style="width:70px;height:70px;font-size:25px">N</div>
        <h2 id="profileName">Your Creator Account</h2>
        <p class="muted">Novareach Digital community profile</p>
        <label>Set your display name</label>
        <input id="nameInput" maxlength="50" placeholder="Enter your name">
        <label>About you</label>
        <textarea id="bioInput" maxlength="250" placeholder="Tell the community about yourself"></textarea>
        <button class="btn full" onclick="saveProfile()">Save Profile</button>
        <div class="row" style="margin-top:20px;gap:25px">
          <div><strong id="followerCount">0</strong><div class="muted">Followers</div></div>
          <div><strong id="followingCount">0</strong><div class="muted">Following</div></div>
          <div><strong id="postCount">0</strong><div class="muted">Posts</div></div>
        </div>
      </div>
      <div class="notice">This initial version saves data in this browser only. It does not yet create real accounts or synchronize followers across devices.</div>
    </section>
  </main>

  <aside class="rightbar">
    <div class="panel">
      <h3>Featured Creator</h3>
      <div id="rightFeatured"></div>
      <button class="btn full" onclick="followFeatured()">Follow Creator</button>
    </div>
    <div class="panel">
      <h3>Explore</h3>
      <p class="muted">🛍️ Shop independent sellers</p>
      <p class="muted">👥 Meet new people</p>
      <p class="muted">🎥 Discover creators</p>
      <p class="muted">🚀 Grow your business</p>
    </div>
  </aside>
</div>

<nav class="bottomnav">
  <button class="active" data-page="home" onclick="openPage('home')">🏠<br>Home</button>
  <button data-page="market" onclick="openPage('market')">🛍️<br>Market</button>
  <button data-page="friends" onclick="openPage('friends')">👥<br>Friends</button>
  <button data-page="videos" onclick="openPage('videos')">▶️<br>Videos</button>
  <button data-page="profile" onclick="openPage('profile')">👤<br>Profile</button>
</nav>

<footer>© <span id="year"></span> Novareach Digital · Connect. Discover. Grow.</footer>

<script>
const featured = {
  name: "Your Creator Account",
  bio: "Welcome to Novareach Digital!"
};

let products = [
  {id:1,name:"Professional Logo Design",price:12000,category:"Services",desc:"Custom logo design for your business.",art:"🎨"},
  {id:2,name:"Wireless Headphones",price:18000,category:"Electronics",desc:"Wireless audio for everyday use.",art:"🎧"},
  {id:3,name:"Fashion Collection",price:15000,category:"Fashion",desc:"Discover independent fashion sellers.",art:"👕"},
  {id:4,name:"Social Media Templates",price:5000,category:"Digital",desc:"Templates for your online content.",art:"📱"}
];

let people = [
  {name:"Creative Studio",bio:"Design and digital creativity."},
  {name:"Video Creator",bio:"Sharing creative video ideas."},
  {name:"Local Business",bio:"Products and services for everyone."}
];

let posts = [
  {name:"Novareach Community",text:"Welcome to Novareach Digital! Discover new people, explore services, and share your ideas.",likes:0},
  {name:"Creative Studio",text:"Creators: what kind of content are you working on this week?",likes:0}
];

let videos = [
  {title:"Welcome to Novareach",url:"",art:"🎬"},
  {title:"Discover creative ideas",url:"",art:"✨"}
];

let following = false;
let followedPeople = new Set();
let profile = {name:"Your Creator Account",bio:""};
let saved = {};

try {
  saved = JSON.parse(localStorage.getItem("novareach_demo") || "{}");
  products = saved.products || products;
  posts = saved.posts || posts;
  videos = saved.videos || videos;
  profile = saved.profile || profile;
  following = !!saved.following;
  followedPeople = new Set(saved.followedPeople || []);
} catch(e) {}

function persist(){
  try{
    localStorage.setItem("novareach_demo",JSON.stringify({
      products,posts,videos,profile,following,
      followedPeople:[...followedPeople]
    }));
  }catch(e){}
}

function money(n){
  return "₦"+Number(n).toLocaleString("en-NG");
}

function safe(value){
  return String(value).replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}

function openPage(id){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  document.querySelectorAll("[data-page]").forEach(b=>{
    b.classList.toggle("active",b.dataset.page===id);
  });
  renderAll();
  window.scrollTo({top:0,behavior:"smooth"});
}

function followFeatured(){
  following=!following;
  persist();
  renderAll();
}

function togglePerson(name){
  if(followedPeople.has(name)) followedPeople.delete(name);
  else followedPeople.add(name);
  persist();
  renderAll();
}

function renderFeatured(){
  const name=safe(profile.name || featured.name);
  const bio=safe(profile.bio || featured.bio);
  document.getElementById("featuredName").textContent=name;
  document.getElementById("featuredFollow").textContent=following?"✓ Following":"＋ Follow";
  document.getElementById("featuredFollow").className=following?"btn light":"btn";
  const html=`<div class="person"><div class="avatar">N</div><div class="personinfo"><strong>${name}</strong><span>${bio}</span></div></div>`;
  document.getElementById("featuredPerson").innerHTML=html;
  document.getElementById("rightFeatured").innerHTML=html;
}

function productCard(p){
  return `<article class="card product">
    <div class="productart">${safe(p.art||"🛍️")}</div>
    <div class="productinfo">
      <span class="tag">${safe(p.category)}</span>
      <h3 style="font-size:15px;margin:8px 0">${safe(p.name)}</h3>
      <div class="price">${money(p.price)}</div>
      <p class="muted" style="margin-top:9px">${safe(p.desc||"")}</p>
      <button class="btn full" onclick="contactSeller('${safe(p.name).replace(/'/g,"&#39;")}')">Enquire</button>
    </div>
  </article>`;
}

function renderProducts(){
  const term=(document.getElementById("productSearch")?.value || document.getElementById("search")?.value || "").toLowerCase();
  const cat=document.getElementById("productCategory")?.value || "All";
  const list=products.filter(p=>
    (cat==="All"||p.category===cat) &&
    (p.name+" "+p.desc+" "+p.category).toLowerCase().includes(term)
  );
  document.getElementById("allProducts").innerHTML=list.length
    ?list.map(productCard).join("")
    :'<div class="empty">No matching listings yet.</div>';
  document.getElementById("homeProducts").innerHTML=products.slice(0,4).map(productCard).join("");
}

function contactSeller(name){
  alert("You selected: "+name+"\n\nSeller enquiries and secure checkout will be available after the backend is connected.");
}

function renderPosts(){
  const html=posts.map((p,i)=>`
    <article class="card">
      <div class="posthead"><div class="avatar">${safe((p.name||"U").charAt(0).toUpperCase())}</div>
      <div><strong>${safe(p.name)}</strong><div class="muted">Community post</div></div></div>
      <div class="postbody">${safe(p.text)}</div>
      <div class="postactions">
        <button onclick="likePost(${i})">♥ Like (${p.likes||0})</button>
        <button onclick="sharePost(${i})">↗ Share</button>
      </div>
    </article>`).join("");
  document.getElementById("homePosts").innerHTML=html;
}

function likePost(i){
  posts[i].likes=(posts[i].likes||0)+1;
  persist();
  renderPosts();
}

function sharePost(i){
  const text=posts[i].name+": "+posts[i].text;
  if(navigator.share){
    navigator.share({title:"Novareach Digital",text}).catch(()=>{});
  }else if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(()=>alert("Post text copied."));
  }else alert(text);
}

function renderPeople(){
  const all=[{name:profile.name,bio:profile.bio||"Featured creator"},...people];
  document.getElementById("peopleList").innerHTML=all.map((p,i)=>{
    const isFeatured=i===0;
    const isFollowing=isFeatured?following:followedPeople.has(p.name);
    return `<div class="person">
      <div class="avatar">${safe(p.name.charAt(0).toUpperCase())}</div>
      <div class="personinfo"><strong>${safe(p.name)}</strong><span>${safe(p.bio)}</span></div>
      <button class="btn small ${isFollowing?"light":""}" onclick="${isFeatured?"followFeatured()":"togglePerson('"+safe(p.name).replace(/'/g,"\\'")+"')"}">${isFollowing?"Following":"Follow"}</button>
    </div>`;
  }).join("");
}

function renderVideos(){
  document.getElementById("videoFeed").innerHTML=videos.map(v=>`
    <article class="card">
      ${v.url && /^https?:\/\//i.test(v.url)
        ? `<div class="videoart"><a style="color:white" target="_blank" rel="noopener noreferrer" href="${safe(v.url)}">▶ Open Video</a></div>`
        : `<div class="videoart">${safe(v.art||"▶")}</div>`}
      <h3>${safe(v.title)}</h3>
      <p class="muted">${v.url?"Open the linked video to watch.":"Demo card — no video uploaded."}</p>
    </article>`).join("");
}

function saveProfile(){
  const name=document.getElementById("nameInput").value.trim();
  const bio=document.getElementById("bioInput").value.trim();
  if(!name){alert("Please enter a display name.");return;}
  profile={name:name.slice(0,50),bio:bio.slice(0,250)};
  persist();renderAll();
  alert("Profile saved in this browser.");
}

function renderAll(){
  renderFeatured();
  renderProducts();
  renderPosts();
  renderPeople();
  renderVideos();
  document.getElementById("profileName").textContent=profile.name;
  document.getElementById("nameInput").value=profile.name;
  document.getElementById("bioInput").value=profile.bio||"";
  document.getElementById("followerCount").textContent=following?1:0;
  document.getElementById("followingCount").textContent=followedPeople.size;
  document.getElementById("postCount").textContent=posts.filter(p=>p.name===profile.name).length;
}

document.getElementById("productForm").addEventListener("submit",e=>{
  e.preventDefault();
  products.unshift({
    id:Date.now(),
    name:document.getElementById("pName").value.trim(),
    price:Number(document.getElementById("pPrice").value),
    category:document.getElementById("pCategory").value,
    desc:document.getElementById("pDesc").value.trim(),
    art:"🛍️"
  });
  persist();e.target.reset();renderAll();
  alert("Listing added to this browser's demo marketplace.");
  openPage("market");
});

document.getElementById("postForm").addEventListener("submit",e=>{
  e.preventDefault();
  const name=document.getElementById("postName").value.trim();
  const text=document.getElementById("postText").value.trim();
  if(!name||!text)return;
  posts.unshift({name,text,likes:0});
  persist();e.target.reset();renderAll();openPage("home");
});

document.getElementById("videoForm").addEventListener("submit",e=>{
  e.preventDefault();
  const title=document.getElementById("vTitle").value.trim();
  const url=document.getElementById("vUrl").value.trim();
  if(!/^https?:\/\//i.test(url)){
    alert("Enter a valid public URL starting with https://");
    return;
  }
  videos.unshift({title,url,art:"▶️"});
  persist();e.target.reset();renderAll();openPage("videos");
});

document.getElementById("search").addEventListener("input",()=>{
  if(document.getElementById("market").classList.contains("active")){
    renderProducts();
  }else{
    openPage("market");
    document.getElementById("productSearch").value=document.getElementById("search").value;
    renderProducts();
  }
});

document.getElementById("year").textContent=new Date().getFullYear();
renderAll();
</script>
</body>
</html>
